# CinetPay Configuration
# Récupérez ces valeurs depuis votre panel CinetPay: https://panel.cinetpay.net/jessna-cinehub/developer
# Allez dans le menu "Intégrations" pour trouver votre API_KEY et API_PASSWORD
# Vérifiez le pays configuré dans votre panel (CI pour Côte d'Ivoire, CD pour RD Congo, etc.)

CINETPAY_API_KEY=sk_test_votre_api_key_ici
CINETPAY_API_PASSWORD=votre_mot_de_passe_api_ici
CINETPAY_MODE=TEST
CINETPAY_COUNTRY=CI
CINETPAY_NOTIFY_URL=https://jessnacinehub.pythonanywhere.com/api/cinetpay/notify
CINETPAY_RETURN_URL=https://jessnacinehub.pythonanywhere.com/api/cinetpay/return
